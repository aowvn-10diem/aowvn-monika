+	// Aow Monika: đường dẫn game do app ngoài truyền qua Intent (extra "aow_game_path") → mở thẳng game, bỏ qua trình duyệt file.
+	static public String getStartupGamePath() {
+		try {
+			KR2Activity a = sInstance;
+			if (a == null || a.getIntent() == null) return "";
+			String p = a.getIntent().getStringExtra("aow_game_path");
+			return p == null ? "" : p;
+		} catch (Throwable t) { return ""; }
+	}
     
