<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Monika" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
    </style>
    <style name="Theme.Monika.Fullscreen" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <!-- Màn chờ khi mở app (Android 12+ dùng SplashScreen hệ thống, máy cũ dùng bản tương thích). -->
    <style name="Theme.Monika.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/charcoal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/monika_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.Monika</item>
    </style>
    <color name="charcoal">#202124</color>
    <color name="brand">#FF7F78</color>
    <color name="cream">#F4F5F2</color>
</resources>
