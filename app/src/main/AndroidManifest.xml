<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Giải nén game nặng ở chạy nền (WorkManager). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Kiểm tra app ngoài (Kirikiroid2, JoiPlay...) đã cài chưa; danh sách app nằm trong config nên cần quyền này.
         App phát hành ngoài CH Play nên dùng được. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Chỉ xin khi cần: đọc game do bản cài TRƯỚC tạo trong Download (gỡ app rồi cài lại, Android 11+ chặn). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:glEsVersion="0x00030000" android:required="false" />

    <application
        android:name=".MonikaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Monika"
        tools:targetApi="35">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,ocr_japanese" />

        <activity
            android:name=".ui.MainActivity"
            android:theme="@style/Theme.Monika.Starting"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Mở bằng Aow Monika" từ trình quản lý file / trình duyệt: file nén, .jar, rom (octet-stream).
                 App nhận diện hệ máy theo config rồi mới chạy đúng giả lập. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/rar" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/java-archive" />
                <data android:mimeType="application/x-java-archive" />
                <data android:mimeType="text/vnd.sun.j2me.app-descriptor" />
                <data android:mimeType="application/x-shockwave-flash" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity
            android:name=".runner.RetroActivity"
            android:process=":game"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.Monika.Fullscreen" />

        <activity
            android:name=".runner.EnginePrepActivity"
            android:exported="false"
            android:theme="@style/Theme.Monika.Fullscreen" />

        <activity
            android:name=".runner.RgssGameActivity"
            android:process=":game"
            android:taskAffinity="com.aow.monika.rgss"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|density|uiMode|layoutDirection"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:exported="false"
            android:theme="@style/Theme.Monika.Fullscreen" />

        <activity
            android:name=".runner.RenpyGameActivity"
            android:process=":game"
            android:taskAffinity="com.aow.monika.renpy"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|density|uiMode|layoutDirection"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:exported="false"
            android:theme="@style/Theme.Monika.Fullscreen" />

        <activity
            android:name=".runner.KirikiriGameActivity"
            android:process=":game"
            android:taskAffinity="com.aow.monika.kirikiri"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:exported="false"
            android:theme="@style/Theme.Monika.Fullscreen" />

        <activity
            android:name=".azahar.AzaharActivity"
            android:process=":game"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.Monika.Fullscreen" />

        <activity
            android:name=".azahar.AzaharInstallActivity"
            android:process=":game"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize"
            android:theme="@style/Theme.Monika.Fullscreen" />

        <activity
            android:name=".runner.WebGameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize"
            android:screenOrientation="fullUser"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.Monika.Fullscreen" />

        <!-- Màn báo lỗi khi app crash (tiến trình riêng). -->
        <activity
            android:name=".CrashActivity"
            android:process=":crash"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Nhận kết quả đăng nhập từ aow.vn/p/device-login.html (aowmonika://login#...). -->
        <activity
            android:name=".account.AuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aowmonika" android:host="login" />
            </intent-filter>
        </activity>

        <!-- Trình duyệt nhúng: Discord / Facebook khi máy chưa cài app. -->
        <activity
            android:name=".browser.InAppBrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize" />

        <!-- Trình cài game Android (APK/APKS/XAPK + OBB): menu popup nổi trên màn đang mở. -->
        <activity
            android:name=".apkinstall.ApkInstallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver
            android:name=".apkinstall.InstallResultReceiver"
            android:exported="false" />
        <receiver
            android:name=".apkinstall.adb.AdbPairing$AdbPairReceiver"
            android:exported="false" />
        <!-- Cách 1: bộ nạp chèn trong game báo tin về Monika + đọc dữ liệu game từ Monika (chỉ gói game đã đăng ký mới vào được). -->
        <provider
            android:name=".apkinstall.LoaderBusProvider"
            android:authorities="${applicationId}.loaderbus"
            android:exported="true" />
        <provider
            android:name=".apkinstall.GameDataProvider"
            android:authorities="${applicationId}.gamedata"
            android:exported="true" />

        <receiver
            android:name=".pack.PackChoiceReceiver"
            android:exported="false" />

        <receiver
            android:name=".download.DownloadReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Dựng sẵn tiến trình :game (tải trước game) — xem runner/GamePreload.kt -->
        <service
            android:name=".runner.GameWarmService"
            android:process=":game"
            android:exported="false" />

        <service
            android:name=".download.BrowserDownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
